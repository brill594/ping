<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>moe.brill.ping-agent-mail</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/brilliant/.local/bin/ping-agent-mail</string>
    <string>serve</string>
    <string>--config</string>
    <string>/Users/brilliant/.config/ping-agent-mail/config.toml</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/brilliant/Library/Logs/ping-agent-mail.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/brilliant/Library/Logs/ping-agent-mail.log</string>
</dict>
</plist>
